# =========================
#  DIN INLOGGNING
# =========================

# Kopiera den här filen till .env och fyll i dina egna uppgifter.
# Filen .env ska INTE laddas upp till GitHub.

# Din e-postadress. Det här är kontot som får logga in.
BRACCI_EMAIL=din-mail@exempel.se

# Ditt lösenord. Minst 8 tecken gärna.
BRACCI_PASSWORD=ditt-losenord-här


# =========================
#  DATABAS
# =========================

# Lämna den här raden tom eller bort lokalt.
# Då används SQLite, som ligger i data/bracci.db och
# inte kräver något installationssteg.
#
# På Render måste den vara satt, eftersom Render raderar
# allt som ligger på serverns disk. Se README.md.

# DATABASE_URL=postgres:// anvandare:losenord@host:5432/databas


# =========================
#  VALFRIKT
# =========================

# Vilken port servern ska lyssna på.
# PORT=3000